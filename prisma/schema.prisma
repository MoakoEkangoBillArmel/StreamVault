generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════
// UTILISATEUR
// ══════════════════════════════════════════

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  name           String?
  role           UserRole        @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  favorites      Favorite[]
  watchlistItems WatchlistItem[]
  watchProgress  WatchProgress[]
  watchHistory   WatchHistory[]
}

enum UserRole {
  USER
  ADMIN
}

// ══════════════════════════════════════════
// CATALOGUE
// ══════════════════════════════════════════

model Media {
  id              String         @id @default(cuid())
  title           String
  titleEnglish    String?
  titleNative     String?
  synopsis        String?
  type            MediaType
  format          MediaFormat?
  status          MediaStatus    @default(UNKNOWN)
  seasonYear      Int?
  seasonQuarter   SeasonQuarter?
  episodeCount    Int?
  coverImage      String?
  bannerImage     String?
  averageScore    Float?
  popularity      Int?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  episodes        Episode[]
  genres          MediaGenre[]
  externalIds     ExternalId[]
  favorites       Favorite[]
  watchlistItems  WatchlistItem[]
  watchProgress   WatchProgress[]
}

enum MediaType {
  TV
  MOVIE
  OVA
  ONA
  SPECIAL
  MUSIC
}

enum MediaFormat {
  TV
  TV_SHORT
  MOVIE
  SPECIAL
  OVA
  ONA
  MUSIC
}

enum MediaStatus {
  RELEASING
  FINISHED
  NOT_YET_RELEASED
  CANCELLED
  HIATUS
  UNKNOWN
}

enum SeasonQuarter {
  WINTER
  SPRING
  SUMMER
  FALL
}

model Episode {
  id            String         @id @default(cuid())
  mediaId       String
  number        Int
  title         String?
  aired         DateTime?
  createdAt     DateTime       @default(now())

  media         Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  watchHistory  WatchHistory[]

  @@unique([mediaId, number])
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  media  MediaGenre[]
}

model MediaGenre {
  mediaId String
  genreId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
}

model ExternalId {
  id         String @id @default(cuid())
  mediaId    String
  provider   String // "jikan", "tmdb"
  externalId String

  media      Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
}

// ══════════════════════════════════════════
// PROVIDER & SOURCE RESOLVER
// ══════════════════════════════════════════

model Provider {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  baseUrl     String?
  createdAt   DateTime @default(now())

  health      ProviderHealth?
}

model ProviderHealth {
  id              String    @id @default(cuid())
  providerId      String    @unique
  successCount    Int       @default(0)
  failureCount    Int       @default(0)
  avgLatencyMs    Int       @default(0)
  lastChecked     DateTime?
  lastFailure     DateTime?
  lastFailureMsg  String?
  circuitOpen     Boolean   @default(false)

  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// ══════════════════════════════════════════
// LISTES UTILISATEUR
// ══════════════════════════════════════════

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

// ══════════════════════════════════════════
// WATCH SYSTEM
// ══════════════════════════════════════════

model WatchProgress {
  id                String      @id @default(cuid())
  userId            String
  mediaId           String
  status            WatchStatus @default(PLAN_TO_WATCH)
  lastWatchedEpNum  Int?
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media             Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

model WatchHistory {
  id              String   @id @default(cuid())
  userId          String
  episodeId       String
  resumePosition  Int      @default(0)
  completed       Boolean  @default(false)
  watchedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

